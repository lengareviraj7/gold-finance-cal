# MongoDB Atlas Connection URI
MONGODB_URI="mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority"

# Database Name (default: siddheshwar_jewelers)
MONGODB_DB="siddheshwar_jewelers"

# Private Owner PIN for accessing the calculator & history
OWNER_PIN="CHANGE_THIS_TO_A_LONG_PRIVATE_PIN"

# Cryptographic Session Secret (must be at least 32 characters long)
SESSION_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES_LONG"

# Public Branding
NEXT_PUBLIC_APP_NAME="Siddheshwar Jewelers"
